# 服务启动时会自动加载工作目录下的 .env 文件（已 export 的环境变量优先，
# 不会被本文件覆盖）；docker compose 部署则由 compose 直接注入环境变量。

# ===== 基础配置 =====
# 引导管理员账号：首次启动时自动创建；密码留空则生成一次性随机密码并打印到日志
BOOTSTRAP_ADMIN_USERNAME=bifang
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# 共享部署令牌（无用户归属的 ACE/MCP 访问）；生产环境建议只发放个人令牌
ACE_TOKEN=replace-with-a-long-random-token
# 静态加密密钥（个人令牌密文、blob 内容加密）；一经设定不可更换，否则历史密文无法解密
BCE_ENCRYPTION_KEY=replace-with-a-stable-long-encryption-secret
DEMO_DATA=false
# PostgreSQL 持久化连接串；留空则使用进程内内存存储（仅限开发）
BCE_DATABASE_URL=postgres://postgres:bce@localhost:5432/bce?sslmode=disable
# 对外访问地址（协议+域名，末尾不带 /）：用于拼接 LinuxDo OAuth 回调地址
BCE_PUBLIC_URL=https://bce.example.com

# ===== 模型通路 =====
# 默认指向硅基流动（api.siliconflow.cn/v1），Qwen3-Embedding-8B / Qwen3-Reranker-8B /
# Qwen3.5-9B 三条通路共享此 Bearer Key；留空则退化为纯词法检索。
# 管理后台「模型与配置」页可在线覆盖全部模型设置。
MODEL_API_KEY=sk-replace-with-your-siliconflow-key
# 如需全本地部署，可覆盖以下端点（重排与嵌入共用同一提供商的地址和 Key，
# 只需单独指定重排模型名）：
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS=1024
# RERANKER_MODEL=qwen3-reranker-0.6b
# ENHANCER_URL=http://localhost:8081/v1
# ENHANCER_MODEL=qwen3:8b
# SUMMARY_MODEL=Qwen/Qwen3-8B  # chunk 摘要专用模型（默认免费档，空则回落增强模型）

# ===== Redis（可选）=====
# 跨实例限流计数与缓存加速；留空则全部计数保存在进程内（单实例默认即可）。
# Redis 故障时自动回退进程内实现，不影响任何请求。
# BCE_REDIS_ADDR=127.0.0.1:6379
# BCE_REDIS_PASSWORD=

# ===== 用户注册（可选）=====
# 自助注册开关在管理后台「系统设置」页在线控制，默认开启。
# 该开关同时控制 LinuxDo 授权登录的首次自动建号（关闭后新用户无法
# 通过授权注册，已注册并关联过的用户不受影响、仍可正常授权登录）。
# 邮箱注册还需配置下方 SMTP 发信，否则注册入口不会出现。
# 验证码发件邮箱（默认谷歌邮箱）：需在 Google 账号中开启两步验证后创建
# 「应用专用密码」（App Password，填写时去掉空格），普通登录密码无法通过
# SMTP 认证。端口 587=STARTTLS、465=隐式 TLS，两种均自动识别
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
# 发件人地址，留空则使用 SMTP_USERNAME
SMTP_FROM=

# ===== Cloudflare Turnstile 人机验证（可选）=====
# 在 Cloudflare 控制台创建 Turnstile 站点后填入；配置后登录与注册接口
# 均要求通过人机验证，留空则完全关闭该校验。
# 本地开发可用 CF 官方测试密钥模拟验证（widget 正常渲染、始终通过）：
#   site key  1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== LinuxDo 授权登录（可选）=====
# 在 https://connect.linux.do/dash/sso 申请接入获取凭证；
# 回调地址填 {BCE_PUBLIC_URL}/api/v1/auth/linuxdo/callback。
# 要求论坛信任等级 ≥ 1；留空则登录页不显示 LinuxDo 入口
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
